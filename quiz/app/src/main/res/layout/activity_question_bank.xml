<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FB"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Question Bank"
        android:textColor="#172554"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/tvQuestionCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 questions saved"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnAddNewQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add New Question"
        android:textAllCaps="false" />

    <Spinner
        android:id="@+id/spFilterSubject"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/questionListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btnCloseQuestionBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textAllCaps="false" />

</LinearLayout>